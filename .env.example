# Optional: the chat agent's parser. Copy this file to `.env` (gitignored) and fill in a key.
# Without a key the console uses its local regex parser and the demo still runs.

# OpenRouter is the default provider.
BURSAR_LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Free models can be rate-limited upstream; this one answers when the primary does not.
LLM_FALLBACK_MODEL=inclusionai/ling-3.2-flash:free
