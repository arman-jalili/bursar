# Copy this file to `.env` at the repository root:
#
#     cp .env.example .env
#
# `.env` is gitignored. It configures the compose stack; `.env.demo` holds the public demo
# constants (Anvil test keys, bearer tokens) and is committed on purpose.

# ── The conversational parser (optional) ─────────────────────────────────────
# OpenRouter key: https://openrouter.ai/keys
# Without a key the console falls back to a local regex parser and the demo still runs.
BURSAR_LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# Free models can be rate-limited upstream; this one answers when the primary does not.
LLM_FALLBACK_MODEL=inclusionai/ling-3.2-flash:free

# ── How the console reaches the governed execution host ──────────────────────
# Containerized Rigorix (the quick-start path):
BURSAR_RIGORIX_BASE_URL=http://rigorix:3001
# If you run Rigorix on the host instead:
# BURSAR_RIGORIX_BASE_URL=http://host.docker.internal:3001

# ── Enterprise audit dashboard (optional) ────────────────────────────────────
# Every governed run posts its signed envelope to this ingest endpoint. The API key is the
# Bearer token; the HMAC key must be the secret the enterprise verifies with
# (`AUDIT_ENVELOPE_HMAC_SECRET`). One key signs approvals and envelopes — set
# BURSAR_AUDIT_HMAC_KEY to that secret; unset uses the public demo key and ingest answers
# 400 INVALID_SIGNATURE.
# BURSAR_AUDIT_BACKEND_URL=https://app.rigorix.eu/api/v1/audit/oss-envelope
# BURSAR_AUDIT_BACKEND_KEY=
# BURSAR_AUDIT_HMAC_KEY=

# ── Server deployments ───────────────────────────────────────────────────────
# The frontend bakes these in at build time (compose build args):
# PUBLIC_CONSOLE_URL=https://demo.example.com:8000
# PUBLIC_EXPLORER_URL=https://demo.example.com:4000
# The console's allowed browser origin (for CORS):
# BURSAR_CORS_ORIGINS=https://demo.example.com

# ── Only for scripts/setup-preconditions.sh (a shell variable, not compose) ──
# The checks run inside the Rigorix container and reach Authority by service name:
#     BURSAR_GATE_URL=http://authority:8001 ./scripts/setup-preconditions.sh
# With a host-run Rigorix, the default http://127.0.0.1:8001 is correct.
