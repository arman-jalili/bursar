# Bursar demo stack — every value is a public Anvil/test value. Never use on a real network.

BURSAR_ENV=local
BURSAR_LOG_LEVEL=INFO
BURSAR_LOG_JSON=false

# One SQLite file for the demo: Mandate writes must be visible to Authority's read-through
# eligibility, and Billing/Evidence live beside it. (ADR-002's per-deployable split is the
# production shape; the demo collapses it so freeze-at-dispatch is real.)
BURSAR_AUTHORITY_DATABASE_URL=sqlite+aiosqlite:////app/data/bursar.db
BURSAR_CONSOLE_DATABASE_URL=sqlite+aiosqlite:////app/data/bursar.db
BURSAR_SQLITE_BUSY_TIMEOUT_MS=10000

# Anvil account 0 — the household owner (signs only; never sends a transaction).
BURSAR_OWNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
BURSAR_HOUSEHOLD_ID=demo-household

# Shared with rigorix-server (RIGORIX_HMAC_KEY) — two different keys verify nothing.
BURSAR_HMAC_KEY=bursar-demo-operator-held-evidence-key-4c1f9a

BURSAR_CHAIN=anvil
BURSAR_RPC_URL=http://anvil:8545
BURSAR_CHAIN_ID=31337
# Filled by the deploy one-shot; the API commands source /shared/chain.env first.
BURSAR_PAYMENT_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
BURSAR_USDC_ADDRESS=0x0000000000000000000000000000000000000000
BURSAR_CONFIRMATIONS_REQUIRED=1

# Anvil account 1 — settlement operator (pays gas, holds the USDC allowance).
BURSAR_SETTLEMENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# The story's constitution: €500/day, €100 signature line.
BURSAR_DAILY_CAP_USDC=500
BURSAR_PER_PAYMENT_THRESHOLD_USDC=100
BURSAR_SETTLEMENT_BUDGET_USDC=20

BURSAR_RIGORIX_BASE_URL=http://host.docker.internal:3001
BURSAR_RIGORIX_API_KEY=bursar-demo
BURSAR_RIGORIX_RUN_TEMPLATE=bursar-payment-dispatch
BURSAR_RIGORIX_SANDBOX=container
BURSAR_RIGORIX_RPC_TIMEOUT_SECONDS=30
BURSAR_PRECONDITION_URL=http://authority:8001/v1/precondition/check
BURSAR_PRECONDITION_TIMEOUT_SECONDS=5
BURSAR_ANCHOR_MODE=per_envelope

# Console upstream: live real services, not the recorded transport.
BURSAR_CONSOLE_UPSTREAM=live

# Authority reads Billing's tables directly because both deployables share the demo SQLite file.
BURSAR_BILLING_READ_MODE=shared

# DEMO ONLY: Anvil account 0, the household owner. The chain gateway uses it to sign the
# on-chain Payment digest so the router lock is exercised; production takes the wallet signature.
BURSAR_DEMO_OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Inside the console container the authority is a sibling service, not loopback.
BURSAR_CONSOLE_AUTHORITY_URL=http://authority:8001
