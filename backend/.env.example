# Bursar environment — copy to .env and fill in real values.
#
# Canonical: .pi/architecture/decisions/ADR-005-authentication-authorization.md
# Reference: .pi/architecture/implementation-roadmap.md#phase-0-project-bootstrap-hours-01
#
# NOTHING in this file is a secret. Real values live only in .env, which is git-ignored.
# Every variable below maps 1:1 to a field in src/shared/infrastructure/config.py;
# tests/test_shared/test_config.py fails if the two drift apart.

# ── Runtime ──────────────────────────────────────────────────────────────────
BURSAR_ENV=local
BURSAR_LOG_LEVEL=INFO
BURSAR_LOG_JSON=true

# ── Database (ADR-002: SQLite + WAL, one file per deployable) ────────────────
BURSAR_AUTHORITY_DATABASE_URL=sqlite+aiosqlite:///./data/authority.db
BURSAR_CONSOLE_DATABASE_URL=sqlite+aiosqlite:///./data/bursar.db
BURSAR_SQLITE_BUSY_TIMEOUT_MS=5000

# ── Mandate / owner identity (ADR-005) ───────────────────────────────────────
# The owner's EVM address is the ONLY valid approval signer. Demo value: Anvil account 0.
BURSAR_OWNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
BURSAR_HOUSEHOLD_ID=demo-household

# ── Evidence signing (ADR-007: HMAC) ────────────────────────────────────────
# Operator-held. MUST NOT be mounted into the agent workspace or any agent process.
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
BURSAR_HMAC_KEY=change-me-operator-held-evidence-key

# ── Chain (ADR-007: Base Sepolia live, Anvil fallback) ──────────────────────
BURSAR_CHAIN=anvil
BURSAR_RPC_URL=http://127.0.0.1:8545
BURSAR_CHAIN_ID=31337
BURSAR_PAYMENT_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
BURSAR_USDC_ADDRESS=0x0000000000000000000000000000000000000000
BURSAR_CONFIRMATIONS_REQUIRED=1

# Settlement wallet. Demo value: Anvil account 1. NEVER a funded mainnet key.
BURSAR_SETTLEMENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# ── Spend guard (ADR-006) ───────────────────────────────────────────────────
BURSAR_DAILY_CAP_USDC=150
BURSAR_PER_PAYMENT_THRESHOLD_USDC=25
BURSAR_SETTLEMENT_BUDGET_USDC=20

# ── Rigorix enforcement (ADR-007) ───────────────────────────────────────────
BURSAR_RIGORIX_BASE_URL=http://127.0.0.1:8080
BURSAR_RIGORIX_API_KEY=change-me-operator-key
# The template whose single run_command step IS the dispatch (SC-2: the command comes from the template).
BURSAR_RIGORIX_RUN_TEMPLATE=bursar-payment-dispatch
# `container` | `vm` | empty. Empty = Rigorix declares no boundary and refuses every run_command step.
BURSAR_RIGORIX_SANDBOX=
BURSAR_RIGORIX_RPC_TIMEOUT_SECONDS=30
BURSAR_PRECONDITION_URL=http://127.0.0.1:8001/v1/precondition/check
BURSAR_PRECONDITION_TIMEOUT_SECONDS=5

# ── Evidence anchoring (ADR-006) ────────────────────────────────────────────
BURSAR_ANCHOR_MODE=per_envelope