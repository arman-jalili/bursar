# Console API base — the browser-facing console surface (default :8000)
VITE_CONSOLE_API_URL=http://127.0.0.1:8000

# Demo bearer token (the console's auth matrix ships this token for local runs)
VITE_OWNER_TOKEN=demo-owner-token

# 1 = run entirely on demo fixtures, never call the console
VITE_FORCE_MOCK=0
